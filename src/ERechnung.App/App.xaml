<Application x:Class="ERechnung.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ERechnung.App.Converters"
             xmlns:vm="clr-namespace:ERechnung.App.ViewModels"
             xmlns:views="clr-namespace:ERechnung.App.Views">
    <Application.Resources>
        <converters:DecimalInputConverter x:Key="DecimalInputConverter"/>

        <DataTemplate DataType="{x:Type vm:RechnungsUebersichtViewModel}">
            <views:RechnungsUebersichtView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RechnungsEditorViewModel}">
            <views:RechnungsEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KundenViewModel}">
            <views:KundenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FirmenprofileViewModel}">
            <views:FirmenprofileView/>
        </DataTemplate>
    </Application.Resources>
</Application>
