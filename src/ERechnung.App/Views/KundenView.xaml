<UserControl x:Class="ERechnung.App.Views.KundenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8D8D8"/>
            <Setter Property="Margin" Value="0,9,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Kundenverwaltung" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Wiederkehrende Rechnungsempfänger zentral verwalten"
                       Foreground="#BDBDBD" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,16,0">
                <Button DockPanel.Dock="Right"
                        Content="Suchen"
                        Command="{Binding SuchenCommand}"
                        Background="#007ACC"
                        Foreground="White"
                        Padding="14,7"
                        Margin="8,0,0,0"/>
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         ToolTip="Firma, Ansprechpartner, Ort, E-Mail oder USt-IdNr. durchsuchen"/>
            </DockPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Neuer Kunde"
                        Command="{Binding NeuCommand}"
                        Background="#16823A"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Bearbeiten"
                        Command="{Binding BearbeitenCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Löschen"
                        Command="{Binding LoeschenCommand}"
                        Background="#A63A3A"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding KundenListe}"
                      SelectedItem="{Binding AusgewaehlterKunde, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      Background="#252526"
                      Foreground="White"
                      BorderBrush="#3E3E42"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#3E3E42"
                      RowBackground="#252526"
                      AlternatingRowBackground="#2D2D2E">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#365F86"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#171717"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#3E3E42"/>
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Firma" Binding="{Binding Firmenname}" Width="1.5*"/>
                    <DataGridTextColumn Header="Ansprechpartner" Binding="{Binding Ansprechpartner}" Width="1.2*"/>
                    <DataGridTextColumn Header="Ort" Binding="{Binding Ort}" Width="*"/>
                    <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="1.4*"/>
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Width="360"
                    Margin="16,0,0,0"
                    Padding="18"
                    Background="#2D2D30"
                    BorderBrush="#55555A"
                    BorderThickness="1"
                    Visibility="{Binding IstEditorSichtbar, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Kundendaten" Foreground="White" FontSize="20" FontWeight="SemiBold"/>

                        <TextBlock Text="Firma *" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding KundenEntwurf.Firmenname, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Ansprechpartner" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding KundenEntwurf.Ansprechpartner, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Straße" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding KundenEntwurf.Strasse, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="PLZ" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Text="{Binding KundenEntwurf.PLZ, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ort" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Text="{Binding KundenEntwurf.Ort, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Land (ISO-Code)" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding KundenEntwurf.Land, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="E-Mail" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding KundenEntwurf.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Telefon" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding KundenEntwurf.Telefon, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="USt-IdNr." Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding KundenEntwurf.UstIdNr, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Bemerkung" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding KundenEntwurf.Bemerkung, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 MinHeight="70"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="{Binding Fehlermeldung}"
                                   Foreground="#FF8F8F"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Abbrechen"
                                    Command="{Binding AbbrechenCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Speichern"
                                    Command="{Binding SpeichernCommand}"
                                    Background="#007ACC"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding Statusmeldung}" Foreground="#BDBDBD"/>
            <TextBlock Text="Bitte warten …"
                       HorizontalAlignment="Right"
                       Foreground="#72B7FF"
                       Visibility="{Binding IstBeschaeftigt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
