<UserControl x:Class="ERechnung.App.Views.RechnungsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E"
             Validation.Error="Validation_Error">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8D8D8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="DecimalInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#FF6B6B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="Padding" Value="7,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#454545"/>
                    <Setter Property="Foreground" Value="#B5B5B5"/>
                    <Setter Property="BorderBrush" Value="#5A5A5A"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Ueberschrift}" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Rechnungsnummer, StringFormat=Rechnungsnummer: {0}}"
                       Foreground="#BDBDBD" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel MinWidth="710" Margin="0,0,8,0">
                <Border Padding="12"
                        Margin="0,0,0,12"
                        Background="#3A3020"
                        BorderBrush="#A67C2E"
                        BorderThickness="1"
                        Visibility="{Binding HatStammdatenHinweis, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StammdatenHinweis}" Foreground="#FFD88A" TextWrapping="Wrap"/>
                </Border>

                <Border Padding="12"
                        Margin="0,0,0,12"
                        Background="#203447"
                        BorderBrush="#4D87B8"
                        BorderThickness="1"
                        Visibility="{Binding HatSnapshotHinweis, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SnapshotHinweis}"
                               Foreground="#B9DFFF"
                               TextWrapping="Wrap"/>
                </Border>

                <Border Padding="16" Background="#2D2D30" BorderBrush="#55555A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Kunde *" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Kunden}"
                                  SelectedItem="{Binding AusgewaehlterKunde, Mode=TwoWay}"
                                  DisplayMemberPath="Firmenname"
                                  Style="{StaticResource ComboStyle}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Firmenprofil *" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding Firmenprofile}"
                                  SelectedItem="{Binding AusgewaehltesFirmaProfil, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource ComboStyle}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Titel" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="0"
                                 Text="{Binding Titel, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Status" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Row="4" Grid.Column="2"
                                  ItemsSource="{Binding StatusOptionen}"
                                  DisplayMemberPath="Anzeigename"
                                  SelectedValuePath="Wert"
                                  SelectedValue="{Binding Status, Mode=TwoWay}"
                                  Style="{StaticResource ComboStyle}"/>

                        <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rechnungsdatum *" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding Rechnungsdatum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fälligkeit" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding Faelligkeitsdatum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Währung" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="EUR" IsReadOnly="True" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,8">
                    <TextBlock Text="Positionen" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Position hinzufügen"
                            Command="{Binding PositionHinzufuegenCommand}"
                            HorizontalAlignment="Right"
                            Background="#16823A"
                            Style="{StaticResource ButtonStyle}"
                            Margin="0"/>
                </Grid>

                <Border Background="#171717" BorderBrush="#3E3E42" BorderThickness="1" Padding="8,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="180"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Beschreibung *" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Menge *" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Einheit" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="Preis netto" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="Steuer %" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="5" Text="Positionsnetto" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Positionen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252526"
                                    BorderBrush="#3E3E42"
                                    BorderThickness="1,0,1,1"
                                    Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" MinWidth="180"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="500"
                                             Style="{StaticResource InputStyle}"/>
                                    <TextBox Grid.Column="1"
                                             Margin="8,0,0,0"
                                             Text="{Binding Menge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalInputConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                             Style="{StaticResource DecimalInputStyle}"/>
                                    <TextBox Grid.Column="2"
                                             Margin="8,0,0,0"
                                             Text="{Binding Einheit, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20"
                                             Style="{StaticResource InputStyle}"/>
                                    <TextBox Grid.Column="3"
                                             Margin="8,0,0,0"
                                             Text="{Binding EinzelpreisNetto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalInputConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                             Style="{StaticResource DecimalInputStyle}"/>
                                    <TextBox Grid.Column="4"
                                             Margin="8,0,0,0"
                                             Text="{Binding Steuersatz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalInputConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                             Style="{StaticResource DecimalInputStyle}"/>
                                    <TextBlock Grid.Column="5"
                                               Margin="8,0,0,0"
                                               Padding="8,7"
                                               Text="{Binding Positionsnetto, StringFormat={}{0:N2} €}"
                                               Foreground="White"
                                               TextAlignment="Right"/>
                                    <Button Grid.Column="6"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Content="×"
                                            FontSize="17"
                                            ToolTip="Position entfernen"
                                            Command="{Binding DataContext.PositionEntfernenCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Background="#A63A3A"
                                            Style="{StaticResource ButtonStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Bemerkung" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Bemerkung, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 MaxLength="2000"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="16" Background="#2D2D30" BorderBrush="#55555A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Netto" Foreground="#D8D8D8" Margin="0,0,20,7"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GesamtbetragNetto, StringFormat={}{0:N2} €}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="Umsatzsteuer" Foreground="#D8D8D8" Margin="0,0,20,7"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UmsatzsteuerBetrag, StringFormat={}{0:N2} €}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Text="Brutto" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,5,20,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GesamtbetragBrutto, StringFormat={}{0:N2} €}" Foreground="#72B7FF" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel VerticalAlignment="Center" Margin="0,0,250,0">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="#FF8F8F" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Statusmeldung}" Foreground="#8EE6A2" TextWrapping="Wrap"/>
                <TextBlock Text="Bitte warten …"
                           Foreground="#72B7FF"
                           Visibility="{Binding IstBeschaeftigt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Abbrechen"
                        Command="{Binding AbbrechenCommand}"
                        Style="{StaticResource ButtonStyle}"/>
                <Button Content="Rechnung speichern"
                        Command="{Binding SpeichernCommand}"
                        Background="#007ACC"
                        Style="{StaticResource ButtonStyle}"
                        Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
