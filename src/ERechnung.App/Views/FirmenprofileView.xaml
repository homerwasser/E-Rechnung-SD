<UserControl x:Class="ERechnung.App.Views.FirmenprofileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8D8D8"/>
            <Setter Property="Margin" Value="0,9,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Firmenprofile" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Absender-, Kontakt- und Bankdaten für Rechnungen verwalten"
                       Foreground="#BDBDBD" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Content="Neues Profil"
                    Command="{Binding NeuCommand}"
                    Background="#16823A"
                    Style="{StaticResource ToolbarButtonStyle}"/>
            <Button Content="Bearbeiten"
                    Command="{Binding BearbeitenCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"/>
            <Button Content="Löschen"
                    Command="{Binding LoeschenCommand}"
                    Background="#A63A3A"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Margin="0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Firmenprofile}"
                      SelectedItem="{Binding AusgewaehltesFirmaProfil, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      Background="#252526"
                      Foreground="White"
                      BorderBrush="#3E3E42"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#3E3E42"
                      RowBackground="#252526"
                      AlternatingRowBackground="#2D2D2E"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#007ACC"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#171717"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#3E3E42"/>
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#8AD0FF"/>
                                <Setter Property="BorderThickness" Value="0,1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*" MinWidth="140"/>
                    <DataGridTextColumn Header="Ansprechpartner" Binding="{Binding Ansprechpartner}" Width="1.2*" MinWidth="120"/>
                    <DataGridTextColumn Header="Ort" Binding="{Binding Ort}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="1.4*" MinWidth="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Width="390"
                    Margin="16,0,0,0"
                    Padding="18"
                    Background="#2D2D30"
                    BorderBrush="#55555A"
                    BorderThickness="1"
                    Visibility="{Binding IstEditorSichtbar, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Profildaten" Foreground="White" FontSize="20" FontWeight="SemiBold"/>

                        <TextBlock Text="Name *" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Ansprechpartner" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.Ansprechpartner, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Straße" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.Strasse, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="PLZ" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Text="{Binding FirmaProfilEntwurf.PLZ, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ort" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Text="{Binding FirmaProfilEntwurf.Ort, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Land (ISO-Code) *" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.Land, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="E-Mail" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Telefon" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.Telefon, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="IBAN" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.IBAN, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="BIC" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.BIC, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="USt-IdNr." Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.UstIdNr, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Lokaler Logo-Pfad" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox Text="{Binding FirmaProfilEntwurf.LogoPfad, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"
                                 ToolTip="Optionaler vollständiger Pfad zu einer lokalen Logo-Datei"/>

                        <TextBlock Text="{Binding Fehlermeldung}"
                                   Foreground="#FF8F8F"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Abbrechen"
                                    Command="{Binding AbbrechenCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Speichern"
                                    Command="{Binding SpeichernCommand}"
                                    Background="#007ACC"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding Statusmeldung}" Foreground="#BDBDBD"/>
            <TextBlock Text="Bitte warten …"
                       HorizontalAlignment="Right"
                       Foreground="#72B7FF"
                       Visibility="{Binding IstBeschaeftigt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
