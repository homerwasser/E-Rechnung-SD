<UserControl x:Class="ERechnung.App.Views.RechnungsUebersichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#454545"/>
                    <Setter Property="Foreground" Value="#B5B5B5"/>
                    <Setter Property="BorderBrush" Value="#5A5A5A"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="Padding" Value="7,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Rechnungen" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Rechnungen erstellen, bearbeiten und ihren Bearbeitungsstand verwalten"
                       Foreground="#BDBDBD" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <TextBlock Text="Statusfilter"
                       Foreground="#D8D8D8"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8"/>
            <ComboBox ItemsSource="{Binding FilterOptionen}"
                      SelectedItem="{Binding AusgewaehlterFilter, Mode=TwoWay}"
                      DisplayMemberPath="Anzeigename"
                      Width="150"
                      Margin="0,0,8,8"
                      Style="{StaticResource ComboStyle}"/>
            <Button Content="Anwenden"
                    Command="{Binding FilterAnwendenCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"/>
            <Button Content="Neue Rechnung"
                    Command="{Binding NeuCommand}"
                    Background="#16823A"
                    Style="{StaticResource ToolbarButtonStyle}"/>
            <Button Content="Bearbeiten"
                    Command="{Binding BearbeitenCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"/>
            <Button Content="Löschen"
                    Command="{Binding LoeschenCommand}"
                    Background="#A63A3A"
                    Style="{StaticResource ToolbarButtonStyle}"/>
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rechnungen}"
                  SelectedItem="{Binding AusgewaehlteRechnung, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  Background="#252526"
                  Foreground="White"
                  BorderBrush="#3E3E42"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3E3E42"
                  RowBackground="#252526"
                  AlternatingRowBackground="#2D2D2E"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#007ACC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#171717"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#3E3E42"/>
                    <Setter Property="Padding" Value="8,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="7,5"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#8AD0FF"/>
                            <Setter Property="BorderThickness" Value="0,1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="1.1*" MinWidth="115"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding Rechnungsdatum, StringFormat={}{0:d}}" Width="*" MinWidth="100"/>
                <DataGridTextColumn Header="Kunde" Binding="{Binding KundeName}" Width="2*" MinWidth="170"/>
                <DataGridTextColumn Header="Brutto" Binding="{Binding GesamtbetragBrutto, StringFormat={}{0:N2} €}" Width="*" MinWidth="115"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusAnzeige}" Width="*" MinWidth="105"/>
                <DataGridTextColumn Header="PDF" Binding="{Binding PdfStatus}" Width="*" MinWidth="105"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12,12,4,4"
                Background="#2D2D30"
                BorderBrush="#55555A"
                BorderThickness="1">
            <WrapPanel>
                <TextBlock Text="PDF und Versand"
                           Foreground="#D8D8D8"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,8"/>
                <Button Content="PDF erstellen/aktualisieren"
                        Command="{Binding PdfErstellenAktualisierenCommand}"
                        Background="#007ACC"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="PDF öffnen"
                        Command="{Binding PdfOeffnenCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Im Explorer anzeigen"
                        Command="{Binding ImExplorerAnzeigenCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="E-Mail-Entwurf öffnen"
                        Command="{Binding EmailEntwurfOeffnenCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="12,12,4,4"
                Background="#2D2D30"
                BorderBrush="#55555A"
                BorderThickness="1">
            <WrapPanel>
                <TextBlock Text="E-Rechnung (EN 16931)"
                           Foreground="#D8D8D8"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,8"/>
                <Button Content="XML exportieren"
                        Command="{Binding XmlExportierenCommand}"
                        Background="#007ACC"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="XML-Ordner öffnen"
                        Command="{Binding XmlImExplorerAnzeigenCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="12"
                Background="#2D2D30"
                BorderBrush="#55555A"
                BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Status übernehmen"
                        Command="{Binding StatusAendernCommand}"
                        Background="#007ACC"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="10,0,0,0"/>
                <TextBlock DockPanel.Dock="Left"
                           Text="Status der Auswahl"
                           Foreground="#D8D8D8"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding StatusOptionen}"
                          SelectedItem="{Binding AusgewaehlterNeuerStatus, Mode=TwoWay}"
                          DisplayMemberPath="Anzeigename"
                          Style="{StaticResource ComboStyle}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <StackPanel Margin="0,0,130,0">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="#FF8F8F" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Statusmeldung}" Foreground="#BDBDBD" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="Bitte warten …"
                       HorizontalAlignment="Right"
                       Foreground="#72B7FF"
                       Visibility="{Binding IstBeschaeftigt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
