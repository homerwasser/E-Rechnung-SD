<UserControl x:Class="ERechnung.App.Views.RechnungsUebersichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="Padding" Value="7,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Rechnungen" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Rechnungen erstellen, bearbeiten und ihren Bearbeitungsstand verwalten"
                       Foreground="#BDBDBD" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Statusfilter" Foreground="#D8D8D8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding FilterOptionen}"
                          SelectedItem="{Binding AusgewaehlterFilter, Mode=TwoWay}"
                          DisplayMemberPath="Anzeigename"
                          Width="150"
                          Style="{StaticResource ComboStyle}"/>
                <Button Content="Anwenden"
                        Command="{Binding FilterAnwendenCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Neue Rechnung"
                        Command="{Binding NeuCommand}"
                        Background="#16823A"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Bearbeiten"
                        Command="{Binding BearbeitenCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Löschen"
                        Command="{Binding LoeschenCommand}"
                        Background="#A63A3A"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rechnungen}"
                  SelectedItem="{Binding AusgewaehlteRechnung, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  Background="#252526"
                  Foreground="White"
                  BorderBrush="#3E3E42"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3E3E42"
                  RowBackground="#252526"
                  AlternatingRowBackground="#2D2D2E">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#007ACC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#171717"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#3E3E42"/>
                    <Setter Property="Padding" Value="8,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="7,5"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#8AD0FF"/>
                            <Setter Property="BorderThickness" Value="0,1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="1.1*" MinWidth="115"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding Rechnungsdatum, StringFormat={}{0:d}}" Width="*" MinWidth="105"/>
                <DataGridTextColumn Header="Kunde" Binding="{Binding KundeName}" Width="2*" MinWidth="180"/>
                <DataGridTextColumn Header="Brutto" Binding="{Binding GesamtbetragBrutto, StringFormat={}{0:N2} €}" Width="*" MinWidth="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusAnzeige}" Width="*" MinWidth="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12"
                Background="#2D2D30"
                BorderBrush="#55555A"
                BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Status übernehmen"
                        Command="{Binding StatusAendernCommand}"
                        Background="#007ACC"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="10,0,0,0"/>
                <TextBlock DockPanel.Dock="Left"
                           Text="Status der Auswahl"
                           Foreground="#D8D8D8"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding StatusOptionen}"
                          SelectedItem="{Binding AusgewaehlterNeuerStatus, Mode=TwoWay}"
                          DisplayMemberPath="Anzeigename"
                          Style="{StaticResource ComboStyle}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="#FF8F8F" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Statusmeldung}" Foreground="#BDBDBD"/>
            </StackPanel>
            <TextBlock Text="Bitte warten …"
                       HorizontalAlignment="Right"
                       Foreground="#72B7FF"
                       Visibility="{Binding IstBeschaeftigt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
