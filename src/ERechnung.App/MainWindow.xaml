<Window x:Class="ERechnung.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Rechnung SD" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2D2D30" Padding="10">
            <StackPanel>
                <TextBlock Text="E-Rechnung SD" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                <Button Content="Dashboard" Padding="10" Margin="0,5" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left"/>
                <Button Content="Neue Rechnung" Padding="10" Margin="0,5" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left"/>
                <Button Content="Kunden" Padding="10" Margin="0,5" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left"/>
                <Button Content="Vorlagen" Padding="10" Margin="0,5" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left"/>
                <Button Content="Einstellungen" Padding="10" Margin="0,5" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Background="#1E1E1E">
            <TextBlock Text="Dashboard - Willkommen" 
                       Foreground="White" 
                       FontSize="20" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>