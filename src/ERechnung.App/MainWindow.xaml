<Window x:Class="ERechnung.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Rechnung SD"
        Height="760"
        Width="1200"
        MinHeight="620"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2D2D30" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="E-Rechnung SD"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Bold"
                           Margin="8,6,8,22"/>

                <StackPanel>
                    <Button Content="Dashboard" Click="Dashboard_Click" Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Content="Neue Rechnung" Click="NeueRechnung_Click" Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Content="Kunden" Click="Kunden_Click" Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Content="Vorlagen" Click="Vorlagen_Click" Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Content="Einstellungen" Click="Einstellungen_Click" Style="{StaticResource NavigationButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="#1E1E1E" Padding="18">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#626267"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
</Window>
